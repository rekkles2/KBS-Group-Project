# Preserve delivered bytes: checksums include original line endings.
# Do not normalize existing datasets, source files, or historical evidence.
* -text

# New repository documentation and maintenance scripts use LF.
/README.md text eol=lf
/SCHEMA.md text eol=lf
/.gitignore text eol=lf
